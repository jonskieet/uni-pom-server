    "@tiptap/starter-kit": "^2.9.1",
    "adm-zip": "^0.5.16",
    "docx": "^9.6.1",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
