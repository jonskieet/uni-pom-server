# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ============================================================
# DATABASE - Supabase PostgreSQL
# ============================================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ============================================================
# JWT SECRET
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================================
# SUPABASE (Optional - for direct API calls)
# ============================================================
SUPABASE_URL=https://bvlehphfqtlcayogvfgm.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# CLOUDFLARE R2 — Lưu file Word (.docx) báo cáo khảo sát
# ============================================================
# Tạo bucket + API Token tại: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=uni-pom-survey-files

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================
# RENDER DEPLOYMENT
# ============================================================
# Uncomment when deploying to Render
# NODE_ENV=production
# PORT=10000
