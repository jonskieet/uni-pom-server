// ============================================================
// Prisma Schema for UNI-POM Database — v2 (upgraded)
// Thay đổi so với v1:
//   1. Role: thêm sales_admin
//   2. PomStatus: mở rộng từ 4 → 10 trạng thái
//   3. Model AuditLog: ghi lại mọi chuyển trạng thái
//   4. Pom: thêm assigned_sale_id, sale_admin_id, closed_at
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USERS
// ============================================================
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  full_name     String
  role          String
  password_hash String
  email         String?
  is_active     Boolean  @default(true)
  avatar_url    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations hiện có
  poms              Pom[]    @relation("CreatedPoms")
  pomReviews        Pom[]    @relation("ReviewedBy")
  products          Product[]
  priceHistory      PriceHistory[]
  surveyReports     SurveyReport[]
  formTemplates     FormTemplate[]

  // Relations mới v2
  assignedSalePoms  Pom[]    @relation("AssignedSale")      // Sale phụ trách
  saleAdminPoms     Pom[]    @relation("PricedBySaleAdmin") // Sale Admin định giá
  auditLogs         AuditLog[]
  notifications     Notification[]

  // Relations chấm công & công tác
  attendances   Attendance[]
  businessTrips BusinessTrip[]

  // Relations lịch tuần
  createdScheduleEvents   ScheduleEvent[]     @relation("ScheduleEventCreator")
  scheduledEventUsers     ScheduleEventUser[] @relation("ScheduleEventUsers")

  // Thông tin ngân hàng — dùng cho QR chuyển khoản công tác phí
  bank_bin          String?
  bank_short        String?
  bank_account_no   String?
  bank_account_name String?

  @@index([username])
  @@index([role])
  @@map("users")
}

// Role: thêm sales_admin
// - sales_admin (cũ là sales): nhận BOM đã duyệt, điều chỉnh giá, gửi cho Sale
// - sales (mới):               nhận BOM từ SaleAdmin, tư vấn KH, chốt HĐ
// - technical:                 tạo BOM + báo cáo khảo sát
// - technical_lead:            duyệt BOM, xử lý sự cố thi công
// - admin:                     giám sát toàn bộ, không can thiệp flow
enum Role {
  admin
  sales_admin
  sales
  technical
  technical_lead
}

// ============================================================
// BRANDS
// ============================================================
model Brand {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  short_name String?
  country    String?
  website    String?
  logo_path  String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())

  products Product[]

  @@index([name])
  @@map("brands")
}

// ============================================================
// CATEGORIES
// ============================================================
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  parent_id   Int?
  created_at  DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([name])
  @@index([parent_id])
  @@map("categories")
}

// ============================================================
// PRODUCTS
// ============================================================
model Product {
  id           Int           @id @default(autoincrement())
  brand_id     Int
  category_id  Int
  name         String
  part_number  String?       @unique
  unit         String        @default("Cái")
  price        Decimal       @default(0)
  sell_price   Decimal?
  vat_rate     Decimal       @default(0.10)
  status       ProductStatus @default(active)
  description  String?
  spec         String?
  origin       String?
  warranty     String?
  image_path   String?
  created_by   Int?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  brand        Brand       @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category     Category    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  creator      User?       @relation(fields: [created_by], references: [id], onDelete: SetNull)
  pomItems     PomItem[]
  priceHistory PriceHistory[]
  surveyItems  SurveyItem[]

  @@index([brand_id])
  @@index([category_id])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  active
  discontinued
  draft
}

// ============================================================
// PRICE HISTORY
// ============================================================
model PriceHistory {
  id         Int      @id @default(autoincrement())
  product_id Int
  old_price  Decimal
  new_price  Decimal
  changed_by Int?
  changed_at DateTime @default(now())
  note       String?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [changed_by], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@map("price_history")
}

// ============================================================
// SOLUTIONS
// ============================================================
model Solution {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  poms          Pom[]
  formTemplates FormTemplate[]

  @@index([code])
  @@map("solutions")
}

// ============================================================
// POMS — v2 (mở rộng)
// ============================================================
model Pom {
  id              Int       @id @default(autoincrement())
  pom_code        String    @unique
  solution_id     Int?
  created_by      Int                           // Kỹ thuật tạo
  reviewed_by     Int?                          // TP KT duyệt
  assigned_sale_id    Int?                      // Sale phụ trách (mới v2)
  sale_admin_id       Int?                      // Sale Admin định giá (mới v2)
  project_name    String
  customer_name   String?
  ward_id         Int?                          // UBND Phường/Xã liên kết (raw SQL table)
  contact_id      Int?                          // Người liên hệ được chọn (raw SQL contacts table)
  status          PomStatus @default(draft)
  note            String?
  return_reason   String?
  revision_count  Int       @default(0)         // Số lần sửa (cho Admin KPI)
  exported_at     DateTime?
  closed_at       DateTime?                     // Khi chốt hoặc lost (mới v2)
  items_updated_at DateTime?                    // NEW: cập nhật mỗi khi PomItem (thiết bị) bị thêm/sửa/xoá
                                                  //      dùng để phiếu khảo sát phát hiện lệch dữ liệu
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  solution         Solution? @relation(fields: [solution_id], references: [id], onDelete: SetNull)
  creator          User      @relation("CreatedPoms", fields: [created_by], references: [id], onDelete: Restrict)
  reviewer         User?     @relation("ReviewedBy", fields: [reviewed_by], references: [id], onDelete: SetNull)
  assignedSale     User?     @relation("AssignedSale", fields: [assigned_sale_id], references: [id], onDelete: SetNull)
  saleAdmin        User?     @relation("PricedBySaleAdmin", fields: [sale_admin_id], references: [id], onDelete: SetNull)
  items            PomItem[]
  survey           SurveyReport?
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([status])
  @@index([created_by])
  @@index([assigned_sale_id])
  @@index([pom_code])
  @@map("poms")
}

// PomStatus — mở rộng từ 4 lên 10 trạng thái
// Luồng chính:
//   draft → submitted → tp_approved → pricing_done → sent_to_client
//   → negotiating → closed_won | closed_lost
// Nhánh sửa (từ negotiating):
//   → revision_price (Sale Admin định giá lại) → pricing_done
//   → revision_tech  (Kỹ thuật sửa)           → submitted (TP duyệt lại)
enum PomStatus {
  draft           // KT đang soạn
  submitted       // KT đã nộp, chờ TP KT duyệt
  tp_approved     // TP KT đã duyệt, chờ Sale Admin định giá
  pricing_done    // Sale Admin đã định giá, chờ Sale gửi KH
  sent_to_client  // Sale đã gửi KH, chờ phản hồi
  negotiating     // KH đang thương lượng
  revision_price  // Sale gửi trả Sale Admin để sửa giá
  revision_tech   // Sale gửi trả Kỹ thuật để sửa phương án
  closed_won      // Chốt thành công
  closed_lost     // Không chốt được
}

// ============================================================
// POM ITEMS
// ============================================================
model PomItem {
  id            Int     @id @default(autoincrement())
  pom_id        Int
  product_id    Int
  quantity      Int     @db.SmallInt
  unit_price    Decimal                   // Giá gốc từ Kỹ thuật
  sale_price    Decimal?                  // Giá Sale Admin điều chỉnh (mới v2)
  vat_rate      Decimal @default(0.10)
  note          String?
  sort_order    Int     @default(0)

  pom         Pom          @relation(fields: [pom_id], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [product_id], references: [id], onDelete: Restrict)
  surveyItems SurveyItem[] // NEW: các dòng phiếu khảo sát tham chiếu tới thiết bị POM này

  @@index([pom_id])
  @@index([product_id])
  @@map("pom_items")
}

// ============================================================
// AUDIT LOG — v2 (mới hoàn toàn)
// Ghi lại mọi chuyển trạng thái POM → Admin giám sát được toàn bộ lịch sử
// ============================================================
model AuditLog {
  id          Int        @id @default(autoincrement())
  pom_id      Int
  actor_id    Int?                          // User thực hiện hành động
  from_status PomStatus?                    // Trạng thái trước (null = tạo mới)
  to_status   PomStatus                     // Trạng thái sau
  action      AuditAction                   // Loại hành động
  note        String?                       // Lý do / ghi chú
  metadata    Json?                         // Dữ liệu bổ sung (VD: giá cũ/mới)
  created_at  DateTime   @default(now())

  pom   Pom   @relation(fields: [pom_id], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([pom_id])
  @@index([actor_id])
  @@index([created_at])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  created           // Kỹ thuật tạo BOM
  submitted         // Kỹ thuật nộp lên TP KT
  tp_approved       // TP KT duyệt
  tp_returned       // TP KT trả về (kèm lý do)
  pricing_done      // Sale Admin hoàn tất định giá
  sent_to_client    // Sale gửi KH
  client_feedback   // KH phản hồi
  return_to_price   // Sale gửi trả Sale Admin sửa giá
  return_to_tech    // Sale gửi trả Kỹ thuật sửa phương án
  price_revised     // Sale Admin sửa giá xong
  tech_revised      // Kỹ thuật sửa phương án xong
  tp_reapproved     // TP KT duyệt lại sau khi sửa KT
  closed_won        // Chốt thành công
  closed_lost       // Không chốt
}

// ============================================================
// SURVEY REPORTS
// ============================================================
model SurveyReport {
  id               Int          @id @default(autoincrement())
  report_code      String       @unique
  report_type      String
  pom_id           Int          @unique
  created_by       Int
  project_name     String
  customer_name    String?
  site_address     String?
  survey_date      String?
  surveyor_name    String?
  status           SurveyStatus @default(draft)
  general_note     String?
  image_url        String?
  form_template_id Int?
  form_data        Json?

  // ── File Word upload (Cloudflare R2) ──────────────────────
  // Thay thế / bổ sung cho form_data: kỹ thuật có thể soạn báo cáo
  // trực tiếp trong Word (không bị giới hạn định dạng/ảnh như form)
  // rồi upload lên đây thay vì điền form online.
  word_file_key         String?    // object key trong bucket R2
  word_file_name        String?    // tên file gốc do người dùng upload
  word_file_size        Int?       // bytes
  word_file_uploaded_by Int?
  word_file_uploaded_at DateTime?

  // ── Đồng bộ danh sách thiết bị với POM ─────────────────────
  items_synced_at DateTime?  // Lần gần nhất danh sách thiết bị được snapshot/đồng bộ từ PomItem
                              // So sánh với Pom.items_updated_at để phát hiện lệch dữ liệu

  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  pom     Pom        @relation(fields: [pom_id], references: [id], onDelete: Restrict)
  creator User       @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items   SurveyItem[]

  @@index([pom_id])
  @@index([status])
  @@map("survey_reports")
}

enum SurveyStatus {
  draft
  completed
}

// ============================================================
// SURVEY ITEMS
// ============================================================
model SurveyItem {
  id                Int      @id @default(autoincrement())
  report_id         Int
  pom_item_id       Int?     // NEW: tham chiếu thiết bị gốc trong POM (nguồn dữ liệu chính)
                              // product_name / quantity_proposed / unit KHÔNG lưu ở đây nữa —
                              // luôn đọc live qua pomItem.product / pomItem.quantity để không
                              // bao giờ bị lệch với POM.
  product_id        Int?     // Chỉ dùng cho thiết bị khảo sát thêm thủ công, KHÔNG có trong POM
                              // (ví dụ phát sinh thực tế ngoài dự trù)
  product_name      String?  // Chỉ dùng khi pom_item_id = null (thiết bị tự thêm, không có product_id)
  quantity_actual   Int      @default(0)
  unit              String   @default("Cái")
  location          String?
  condition_note    String?
  is_removed_from_pom Boolean @default(false) // NEW: thiết bị này đã bị xoá khỏi POM sau khi khảo sát
                                                // (giữ lại lịch sử khảo sát thực tế, không xoá cứng)
  sort_order        Int      @default(0)

  report  SurveyReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  pomItem PomItem?     @relation(fields: [pom_item_id], references: [id], onDelete: SetNull)
  product Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([report_id])
  @@index([pom_item_id])
  @@map("survey_items")
}

// ============================================================
// FORM TEMPLATES
// ============================================================
model FormTemplate {
  id          Int      @id @default(autoincrement())
  solution_id Int
  name        String
  description String?
  schema      Json     @default("[]")
  version     Int      @default(1)
  is_active   Boolean  @default(true)
  created_by  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  solution Solution @relation(fields: [solution_id], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([solution_id])
  @@map("form_templates")
}

// ============================================================
// NOTIFICATIONS — Hệ thống thông báo nội bộ
// Được tạo tự động mỗi khi có chuyển trạng thái BOM quan trọng
// ============================================================
model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int                                    // Người nhận
  pom_id     Int?                                   // BOM liên quan (nullable)
  task_id    Int?                                   // Nhiệm vụ Planner liên quan (nullable)
  type       String                                 // Loại: status_change | request_price | request_tech | approved | closed | task_comment
  title      String                                 // Tiêu đề ngắn
  message    String                                 // Nội dung chi tiết
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pom  Pom?  @relation(fields: [pom_id],  references: [id], onDelete: SetNull)

  @@index([user_id, is_read])
  @@index([pom_id])
  @@index([task_id])
  @@index([created_at])
  @@map("notifications")
}

// ============================================================
// THÊM VÀO CUỐI FILE schema.prisma HIỆN TẠI
// ============================================================

// 1. Trong model User, thêm 2 relations này:
//
//   attendances   Attendance[]
//   businessTrips BusinessTrip[]

// ============================================================
// ATTENDANCE — Chấm công
// ============================================================
model Attendance {
  id         Int       @id @default(autoincrement())
  user_id    Int
  date       DateTime  @db.Date
  check_in   DateTime?
  check_out  DateTime?
  note       String?
  status     String    @default("present") // present | late | absent | leave
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([date])
  @@index([user_id])
  @@map("attendance")
}

// ============================================================
// BUSINESS TRIPS — Báo cáo chi phí công tác (header)
// ============================================================
model BusinessTrip {
  id              Int      @id @default(autoincrement())
  user_id         Int
  report_date     DateTime @db.Date
  time_period     String?                  // "08/06-11/06/2026"
  advance_amount  Decimal  @default(0)     // Tạm ứng
  total_amount    Decimal  @default(0)     // Tổng chi phí
  return_amount   Decimal  @default(0)     // Hoàn tạm ứng = Tạm ứng - Tổng chi
  status          String   @default("pending") // pending | approved | rejected
  note            String?
  payment_method  String   @default("cash")    // cash | transfer
  is_paid         Boolean  @default(false)      // đã chuyển khoản / chi trả xong
  paid_at         DateTime?
  paid_by         Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user  User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items BusinessTripItem[]

  @@index([user_id])
  @@index([report_date])
  @@index([status])
  @@map("business_trips")
}

// ============================================================
// BUSINESS TRIP ITEMS — Chi tiết từng dòng chi phí
// ============================================================
model BusinessTripItem {
  id          Int      @id @default(autoincrement())
  trip_id     Int
  date        DateTime? @db.Date
  ward        String?   // Xã/Phường/Sở
  province    String?   // Tỉnh
  content     String?   // Nội dung công tác
  location    String?   // Địa điểm
  description String?   // Diễn giải
  note        String?   // Ghi chú
  has_invoice Boolean   @default(false)
  sale_person String?   // Kinh doanh
  tech_person String?   // Kỹ thuật
  unit        String    @default("Ngày")
  quantity    Decimal   @default(1)
  unit_price  Decimal   @default(0)
  total_price Decimal   @default(0)
  sort_order  Int       @default(0)

  trip BusinessTrip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
  @@map("business_trip_items")
}


// ============================================================
// SCHEDULE EVENTS — Module Lịch tuần
// Thay thế bảng trắng thủ công của công ty
// ============================================================
model ScheduleEvent {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(300)
  description String?
  date        DateTime @db.Date
  start_time  String?  @db.VarChar(5)   // "HH:MM"
  end_time    String?  @db.VarChar(5)   // "HH:MM"
  category    String   @default("other") // meeting | trip | task | deadline | other
  priority    String   @default("medium") // high | medium | low
  location    String?  @db.VarChar(300)
  created_by  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  creator       User                 @relation("ScheduleEventCreator", fields: [created_by], references: [id], onDelete: Restrict)
  assignedUsers ScheduleEventUser[]

  @@index([date])
  @@index([created_by])
  @@map("schedule_events")
}

model ScheduleEventUser {
  event_id Int
  user_id  Int

  event ScheduleEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User          @relation("ScheduleEventUsers", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
  @@map("schedule_event_users")
}
